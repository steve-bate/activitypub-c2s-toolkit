{
  "name": "activitypub-c2s-client",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "sidecar:dev": "tsx sidecar/server.ts",
    "sidecar:typecheck": "tsc -p tsconfig.sidecar.json --noEmit",
    "sidecar:build": "tsc -p tsconfig.sidecar.json",
    "sidecar:start": "node dist-sidecar/sidecar/server.js",
    "test:unit": "vitest run",
    "lint": "npx eslint . && npx vue-tsc --strict --noEmit && check-unused-comp && npx knip",
    "lint:dups": "jscpd --min-tokens 75 --ignore '**/node_modules/**,**/dist/**,**/.vite/**' src/"
  },
  "dependencies": {
    "@formkit/icons": "^2.1.2",
    "@formkit/vue": "^2.1.2",
    "@vueuse/core": "^15.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dayjs": "^1.11.23",
    "handlebars": "^4.7.10",
    "pinia": "^4.1.0",
    "primeicons": "^8.0.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue3-json-viewer": "github:steve-bate/vue3-json-viewer#dist"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "unrs-resolver@1.11.1": true,
    "vue-demi@0.14.10": true,
    "esbuild@0.28.1": true
  }
}
